biomass_Md = c((B_Ru_Lo + B_Ru_Up)/2, (B_Ce_Lo + B_Ce_Up)/2, (B_Dd_Lo + B_Dd_Up)/2, (B_Rt_Lo + B_Rt_Up)/2, (B_Ca_Lo + B_Ca_Up)/2, (B_Ap_Lo + B_Ap_Up)/2))
